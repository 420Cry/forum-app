{
  "name": "forum-app",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "nuxt dev --dotenv .env",
    "build": "nuxt build --dotenv .env.production",
    "dev": "nuxt dev --dotenv .env",
    "dev:debug": "nuxt dev --dotenv .env.debug",
    "generate": "nuxt generate --dotenv .env.production",
    "preview": "nuxt preview --dotenv .env.production",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.mjs",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage",
    "test:watch": "vitest --config vitest.config.mjs"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.14.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/supabase": "^2.0.9",
    "@sendbird/chat": "^4.22.9",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "nuxt": "^4.3.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.27",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.61",
    "@nuxt/icon": "^2.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
