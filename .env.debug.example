# Local FE → staging/prod BE (for debugging auth/API latency, CORS, etc.)
# Usage:
#   cp .env.debug.example .env.debug
#   # fill SUPABASE_* from the hosted project (Dashboard → API Keys)
#   bun run dev:debug
#

PORT=3000

# Staging/prod forum-api
NUXT_PUBLIC_FORUM_API_URL=BE_API_URL

# Hosted Supabase (same project the staging API uses)
NUXT_PUBLIC_SUPABASE_URL=SUPABASE_URL
NUXT_PUBLIC_SUPABASE_KEY=SUPABASE_KEY
