FROM oven/bun:1.4.2-alpine

WORKDIR /app

# package.json / lock are enough for the image; node_modules is a named volume
# in docker-compose.dev.yml, so a `RUN bun install` here would be masked and
# then repeated by the compose start command.
COPY package.json bun.lock ./
COPY . .

EXPOSE 3000

CMD ["bun", "run", "dev"]
