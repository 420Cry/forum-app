# Base env file (host-native dev, staging overrides, etc.)
# For `forum dev`, copy .env.local.example → .env.local and run `forum env:sync`.

# forum-api base URL (used by onboard API calls)
NUXT_PUBLIC_FORUM_API_URL=

# App port (used by docker-compose)
PORT=3000

# Supabase (@nuxtjs/supabase)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
