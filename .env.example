# forum-api base URL (used by onboard API calls)
# forum-server: http://api.forum.test
# local dev: http://localhost:3001
NUXT_PUBLIC_FORUM_API_URL=http://api.forum.test

# App port (used by docker-compose)
PORT=3000

# Supabase (@nuxtjs/supabase)
# Host-native: http://127.0.0.1:54321
# forum-server Docker: http://supabase.forum.test
# Run `forum db:status` in forum-server for the anon/publishable key.
NUXT_PUBLIC_SUPABASE_URL=http://supabase.forum.test
NUXT_PUBLIC_SUPABASE_KEY=
